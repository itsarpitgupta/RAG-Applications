# LLM API Configuration (xAI Grok or GroqCloud)
GROK_API_KEY="your-groq-or-grok-api-key-here"
GROK_MODEL="openai/gpt-oss-120b"
GROK_BASE_URL="https://api.groq.com/openai/v1"

# Embedding Configuration
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"

# Scheduler Configuration
SCHEDULER_INTERVAL_HOURS=1

# Storage Paths (relative to project root)
STORAGE_RAW_DOCS_DIR="storage/raw_docs"
STORAGE_FAISS_DIR="storage/faiss_index"
STORAGE_DB_PATH="storage/app.db"
